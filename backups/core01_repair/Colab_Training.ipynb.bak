{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "# NexusAI Core-01 \u2014 Google Colab Training (Kaggle-free workflow)\n\n**Our own model. Our own tokenizer. Our own pipeline. FineWeb = text data only.**\n\nThis notebook does EVERYTHING inside Colab: clone the GitHub repo \u2192 verify \u2192\ndownload FineWeb shard 0 \u2192 prepare the 100M-token corpus \u2192 verify \u2192 GPU smoke\ntest \u2192 full pretraining. **Kaggle is not used at all.**\n\n| Stage | Needs GPU? | Approval flag |\n|---|---|---|\n| Clone, deps, Drive, FineWeb verify | no | \u2014 |\n| Dataset download + prep | no | `APPROVE_DATASET_PREPARATION` |\n| Dataset/tokenizer/model/GPU verify | no | \u2014 |\n| Smoke test (~200 steps) | YES | `APPROVE_SMOKE_TEST` |\n| Full training (~100M tokens) | YES | `APPROVE_FULL_TRAINING` |\n\nAll flags default **False**. Enable ONE at a time after reading the plan.\nCheckpoints + dataset save to Google Drive so sessions can resume."
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 2 \u2014 Environment Verification (read-only)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import os, sys, platform, shutil, subprocess\nENV_OK = False\nprint(\"python:\", sys.version.split()[0], \"|\", platform.platform())\nimport torch\nprint(\"torch:\", torch.__version__, \"| cuda_build:\", torch.version.cuda,\n      \"| cuda_available:\", torch.cuda.is_available())\nif torch.cuda.is_available():\n    p = torch.cuda.get_device_properties(0)\n    print(\"gpu:\", p.name, \"| vram %.2f GB\" % (p.total_memory/1e9),\n          \"| capability\", p.major, p.minor)\nfor mod, pip in [(\"sentencepiece\",\"sentencepiece\"),(\"pyarrow\",\"pyarrow\"),(\"numpy\",\"numpy\")]:\n    try:\n        m=__import__(mod); print(mod+\":\", getattr(m,\"__version__\",\"ok\"))\n    except ImportError:\n        print(mod+\": MISSING (will install in Cell 5)\")\nfor d in [\"/content\", \"/content/drive/MyDrive\"]:\n    try:\n        u=shutil.disk_usage(d); print(\"disk\",d,\"free %.1f GB\"%(u.free/1e9))\n    except Exception as e: print(\"disk\",d,\"?\",str(e)[:60])\nprint(\"cpu_count:\", os.cpu_count())\ntry:\n    import psutil; print(\"ram %.1f GB\"%(psutil.virtual_memory().total/1e9))\nexcept Exception: pass\nENV_OK = True"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 3 \u2014 Clone GitHub Repository\n\nClones the public repo `mrhasibuldev/ai-breand` (branch `main`) into\n`/content/nexusai`. Repo is PUBLIC \u2014 no credentials needed.\nVerifies commit hash and required source files exist."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import subprocess, os\nREPO = \"https://github.com/mrhasibuldev/ai-breand.git\"\nSRC = \"/content/nexusai\"\nCLONE_OK = False\nif os.path.isdir(os.path.join(SRC, \".git\")):\n    print(\"repo already cloned\")\nelse:\n    r = subprocess.run([\"git\",\"clone\",\"--depth\",\"1\",REPO,SRC],\n                       capture_output=True, text=True, timeout=600)\n    print(r.stdout[-500:] if r.stdout else \"\", r.stderr[-500:] if r.stderr else \"\")\n    assert r.returncode == 0, \"git clone failed \u2014 check internet\"\nhead = subprocess.run([\"git\",\"-C\",SRC,\"rev-parse\",\"HEAD\"],\n                      capture_output=True, text=True).stdout.strip()\nbranch = subprocess.run([\"git\",\"-C\",SRC,\"rev-parse\",\"--abbrev-ref\",\"HEAD\"],\n                        capture_output=True, text=True).stdout.strip()\nprint(\"commit:\", head, \"| branch:\", branch)\nREQUIRED = [\"packages/ai-core/core01/transformer.py\",\n            \"packages/ai-core/core01/training.py\",\n            \"packages/ai-core/core01/dataset.py\",\n            \"packages/ai-core/core01/pretraining_driver.py\",\n            \"packages/ai-core/core01/tokenizer_interface.py\",\n            \"packages/ai-core/core01/inference.py\",\n            \"packages/ai-core/data/prepare_english_corpus.py\",\n            \"packages/ai-core/models/nexusai_core_01/config/model_config.py\",\n            \"packages/ai-core/data/experimental/phase9_2/tokenizers/bpe_8k/sp_bpe_8k.model\",\n            \"packages/ai-core/data/experimental/phase9_2/tokenizers/bpe_8k/sp_bpe_8k.vocab\"]\nmissing = [p for p in REQUIRED if not os.path.exists(os.path.join(SRC,p))]\nprint(\"missing files:\", missing if missing else \"NONE\")\nCLONE_OK = (not missing)\nprint(\"CLONE_OK =\", CLONE_OK)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 4 \u2014 Dependency Installation (conditional, minimal)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "# Install ONLY what is missing. sentencepiece = tokenizer; pyarrow = parquet prep.\nimport subprocess, sys\nneed = []\nfor mod, pip in [(\"sentencepiece\",\"sentencepiece\"),(\"pyarrow\",\"pyarrow\")]:\n    try: __import__(mod)\n    except ImportError: need.append(pip)\nif need:\n    print(\"installing:\", need)\n    r = subprocess.run([sys.executable,\"-m\",\"pip\",\"install\",\"-q\"]+need,\n                       capture_output=True, text=True, timeout=600)\n    print(\"pip rc:\", r.returncode, r.stderr[-300:] if r.returncode else \"ok\")\nelse:\n    print(\"all deps present \u2014 nothing to install\")\n# verify imports now\nimport sentencepiece, pyarrow\nprint(\"sentencepiece\", sentencepiece.__version__, \"| pyarrow\", pyarrow.__version__)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 5 \u2014 Import Verification (code-level, no training)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "assert CLONE_OK, \"clone failed \u2014 fix Cell 3\"\nimport sys, os\nAI_CORE = \"/content/nexusai/packages/ai-core\"\nMODELS  = \"/content/nexusai/packages/ai-core/models\"\nfor p in (AI_CORE, MODELS):\n    if p not in sys.path: sys.path.insert(0, p)\nfrom nexusai_core_01.config.model_config import NexusAICore01Config\nfrom core01.transformer import NexusAICore01\nfrom core01.training import PretrainingEngine\nfrom core01.dataset import PackedTextDataset\nfrom core01.tokenizer_interface import NexusAITokenizer\nfrom core01.inference import InferenceEngine\nprint(\"all core01 imports OK\")\ncfg = NexusAICore01Config()\nm = NexusAICore01(cfg)\nprint(\"params:\", m.count_parameters())\nIMPORT_OK = True"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 6 \u2014 Google Drive Mount & Folder Structure\n\nCreates the persistent layout. Everything valuable (dataset, checkpoints,\nlogs, reports) lives on Drive; Colab `/content/work` is scratch only."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "from google.colab import drive\ndrive.mount(\"/content/drive\")\nDRIVE_ROOT = \"/content/drive/MyDrive/NexusAI\"\nfor sub in [\"source_data\",\"data\",\"package\",\"tokenizer\",\"checkpoints\",\n            \"logs\",\"reports\",\"checkpoints_smoke\",\"checkpoints_full\"]:\n    os.makedirs(os.path.join(DRIVE_ROOT, sub), exist_ok=True)\nWORK = \"/content/work/nexusai_core01\"\nfor sub in [\"prepared_dataset\",\"logs\"]:\n    os.makedirs(os.path.join(WORK, sub), exist_ok=True)\nprint(\"Drive tree:\")\nfor root,dirs,files in os.walk(DRIVE_ROOT):\n    print(\" \", root.replace(DRIVE_ROOT,\"NexusAI\"), dirs, files)\nDRIVE_OK = os.path.isdir(DRIVE_ROOT)\nprint(\"DRIVE_OK =\", DRIVE_OK)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 7 \u2014 Storage Availability Check"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import shutil\nneed_gb = 6.0   # shard ~2.1GB + prepared ~0.5GB + ckpts headroom + margin\nfree = shutil.disk_usage(\"/content\").free/1e9\nprint(\"colab disk free: %.1f GB | needed ~%.1f GB\" % (free, need_gb))\nSTORAGE_OK = free > need_gb\nprint(\"STORAGE_OK =\", STORAGE_OK)\nif not STORAGE_OK:\n    print(\"Not enough disk \u2014 free space or use a runtime with more storage.\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 8 \u2014 FineWeb Source Verification (read-only, no download)\n\nChecks the official HF repo `HuggingFaceFW/fineweb`, config `sample-10BT`,\nlicense `odc-by`, shard count, and shard-0 size via HEAD request.\nRequires internet (Colab has it by default)."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import json, urllib.request\nFINEWEB_OK = False\ntry:\n    meta = json.load(urllib.request.urlopen(\n        \"https://huggingface.co/api/datasets/HuggingFaceFW/fineweb\", timeout=30))\n    cd = meta.get(\"cardData\") or {}\n    print(\"repo: HuggingFaceFW/fineweb | license:\", cd.get(\"license\"),\n          \"| language:\", cd.get(\"language\"))\n    print(\"attribution: 'FineWeb by Hugging Face' (ODC-By 1.0)\")\n    print(\"Common Crawl ToS: https://commoncrawl.org/terms-of-use\")\n    shards = json.load(urllib.request.urlopen(\n        \"https://huggingface.co/api/datasets/HuggingFaceFW/fineweb/parquet/sample-10BT\",\n        timeout=30))[\"train\"]\n    print(\"sample-10BT shards:\", len(shards))\n    SHARD_URL = (\"https://huggingface.co/api/datasets/HuggingFaceFW/fineweb\"\n                 \"/parquet/sample-10BT/train/0.parquet\")\n    r = urllib.request.urlopen(urllib.request.Request(SHARD_URL, method=\"HEAD\"), timeout=30)\n    size = int(r.headers.get(\"Content-Length\", 0))\n    print(\"shard0 size: %d bytes = %.2f GiB\" % (size, size/2**30))\n    try:\n        r2 = urllib.request.urlopen(urllib.request.Request(\n            SHARD_URL, headers={\"Range\":\"bytes=0-0\"}), timeout=30)\n        print(\"HTTP Range support:\", r2.status in (200,206))\n    except Exception as e: print(\"range probe:\", e)\n    FINEWEB_OK = (size > 1_500_000_000)\n    print(\"FINEWEB_OK =\", FINEWEB_OK)\nexcept Exception as e:\n    print(\"FineWeb verification FAILED:\", repr(e))\n    print(\"Check Colab internet access and retry.\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 9 \u2014 Dataset Preparation Plan \u2014 **OWNER APPROVAL GATE**\n\n`APPROVE_DATASET_PREPARATION=False` by default.\n\n**What will happen if you approve:**\n- Download ONLY FineWeb `sample-10BT` shard 0 (~2.0 GiB) to Colab temp disk\n- Run OUR `prepare_english_corpus.py` (existing code, unmodified)\n- Target **100,000,000 Core-01 SentencePiece tokens**, 0.5% buffer, 1.5% val, seed 42\n- Outputs \u2192 `/content/work/prepared_dataset/` then backed up to Drive `NexusAI/data/`\n- Expected runtime: download ~10 min + prep ~30\u201360 min (CPU)\n- Historical proof: shard 0 alone produced 100,499,546 tokens on Kaggle\n\nSet the flag True ONLY after reading this."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "APPROVE_DATASET_PREPARATION = False   # <-- owner sets True to authorize\n\nSHARD = \"/content/work/nexusai_core01/fineweb_sample10bt_shard0.parquet\"\nPREPARED = \"/content/work/nexusai_core01/prepared_dataset\"\nPREP_DONE = False\n\nif not APPROVE_DATASET_PREPARATION:\n    print(\"PREP BLOCKED: APPROVE_DATASET_PREPARATION=False (default).\")\nelse:\n    assert CLONE_OK and FINEWEB_OK and STORAGE_OK and DRIVE_OK,         \"preconditions failed (clone/fineweb/storage/drive)\"\n    import urllib.request, time, hashlib, os, subprocess\n    os.makedirs(\"/content/work/nexusai_core01\", exist_ok=True)\n    expected = 2147292183  # verified shard0 size\n    # --- download shard 0 (streaming, atomic) ---\n    if os.path.exists(SHARD) and os.path.getsize(SHARD) == expected:\n        print(\"shard already present, correct size \u2014 skipping download\")\n    else:\n        t0=time.time(); last=0\n        req = urllib.request.Request(SHARD_URL)\n        with urllib.request.urlopen(req, timeout=60) as r, \\\n             open(SHARD+\".part\",\"wb\") as f:\n            total = int(r.headers.get(\"Content-Length\", expected)); got=0\n            while True:\n                ch = r.read(1<<22)\n                if not ch: break\n                f.write(ch); got += len(ch)\n                if time.time()-last>5:\n                    print(\"  %.2f/%.2f GB (%.0f%%) %.1f MB/s\"%(\n                        got/1e9,total/1e9,100*got/total,\n                        got/(time.time()-t0)/1e6), flush=True); last=time.time()\n        os.replace(SHARD+\".part\", SHARD)\n        print(\"download done in %.0fs\"%(time.time()-t0))\n    actual = os.path.getsize(SHARD)\n    print(\"size check:\", actual==expected, \"(%d bytes)\"%actual)\n    h=hashlib.sha256()\n    with open(SHARD,\"rb\") as f:\n        for c in iter(lambda:f.read(1<<22),b\"\"): h.update(c)\n    print(\"shard sha256:\", h.hexdigest())\n    # --- run OUR prep script (unmodified) ---\n    PREP = \"/content/nexusai/packages/ai-core/data/prepare_english_corpus.py\"\n    TOK  = \"/content/nexusai/packages/ai-core/data/experimental/phase9_2/tokenizers/bpe_8k/sp_bpe_8k.model\"\n    cmd = [sys.executable, PREP,\n           \"--input-parquet\", SHARD, \"--tokenizer\", TOK,\n           \"--output-dir\", PREPARED,\n           \"--target-tokens\",\"100000000\",\"--buffer-fraction\",\"0.005\",\n           \"--val-fraction\",\"0.015\",\"--seed\",\"42\",\n           \"--source-name\",\"fineweb\",\"--source-config\",\"sample-10BT\",\n           \"--source-license\",\"ODC-By-1.0\"]\n    print(\"running prep:\", \" \".join(cmd))\n    r = subprocess.run(cmd, cwd=\"/content/work\")\n    print(\"prep exit:\", r.returncode)\n    PREP_DONE = (r.returncode==0)\n    for fn in [\"english_train.jsonl\",\"english_val.jsonl\",\"manifest.json\",\n               \"preparation_report.md\",\"deduplication_report.json\"]:\n        p=os.path.join(PREPARED,fn)\n        print((\"OK \" if os.path.exists(p) else \"MISSING \")+fn,\n              os.path.getsize(p) if os.path.exists(p) else \"\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 10 \u2014 Dataset Integrity Audit (read-only)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "DATASET_OK = False\ntrain_path = os.path.join(PREPARED,\"english_train.jsonl\")\nval_path   = os.path.join(PREPARED,\"english_val.jsonl\")\nman_path   = os.path.join(PREPARED,\"manifest.json\")\nif not PREP_DONE or not all(os.path.exists(p) for p in [train_path,val_path,man_path]):\n    print(\"no prepared dataset \u2014 run Cell 9 first\")\nelse:\n    import json\n    tr=[json.loads(l) for l in open(train_path,encoding=\"utf-8\") if l.strip()]\n    va=[json.loads(l) for l in open(val_path,encoding=\"utf-8\") if l.strip()]\n    tr_tok=sum(d[\"ntok\"] for d in tr); va_tok=sum(d[\"ntok\"] for d in va)\n    print(\"train: %s docs / %s tokens\"%(f\"{len(tr):,}\",f\"{tr_tok:,}\"))\n    print(\"val:   %s docs / %s tokens\"%(f\"{len(va):,}\",f\"{va_tok:,}\"))\n    overlap=len({d[\"text\"] for d in tr}&{d[\"text\"] for d in va})\n    empty=sum(1 for d in tr+va if not d[\"text\"].strip())\n    dup=(len(tr)+len(va))-len({d[\"text\"] for d in tr+va})\n    print(\"overlap:\",overlap,\"| empty:\",empty,\"| dups:\",dup)\n    man=json.load(open(man_path,encoding=\"utf-8\"))\n    print(\"manifest tokens:\",man[\"target\"][\"actual_accepted_tokens\"])\n    sys.path.insert(0,\"/content/nexusai/packages/ai-core\")\n    from core01.pretraining_driver import load_texts\n    docs=load_texts(train_path)\n    print(\"driver load_texts:\",len(docs))\n    DATASET_OK=(overlap==0 and empty==0 and dup==0 and len(docs)==len(tr)\n                and abs((tr_tok+va_tok)-man[\"target\"][\"actual_accepted_tokens\"])<1000)\n    print(\"DATASET_OK:\",DATASET_OK)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 11 \u2014 Dataset Backup to Google Drive"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import shutil, os\nDST = os.path.join(DRIVE_ROOT,\"data\")\nif DATASET_OK:\n    for fn in [\"english_train.jsonl\",\"english_val.jsonl\",\"manifest.json\",\n               \"preparation_report.md\",\"deduplication_report.json\"]:\n        src=os.path.join(PREPARED,fn); dst=os.path.join(DST,fn)\n        if os.path.exists(src) and (not os.path.exists(dst) or\n           os.path.getsize(src)!=os.path.getsize(dst)):\n            shutil.copy2(src,dst); print(\"copied\",fn)\n        elif os.path.exists(dst): print(\"already on Drive:\",fn)\n    print(\"dataset backed up to\",DST)\nelse:\n    print(\"DATASET_OK=False \u2014 backup skipped\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 12 \u2014 Tokenizer Verification"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "TOKENIZER_OK=False\nTOK=\"/content/nexusai/packages/ai-core/data/experimental/phase9_2/tokenizers/bpe_8k/sp_bpe_8k.model\"\nassert os.path.exists(TOK), \"tokenizer missing in clone\"\nsys.path.insert(0,\"/content/nexusai/packages/ai-core\")\nsys.path.insert(0,\"/content/nexusai/packages/ai-core/models\")\nfrom core01.tokenizer_interface import NexusAITokenizer\nfrom nexusai_core_01.config.model_config import NexusAICore01Config\ncfg=NexusAICore01Config()\ntok=NexusAITokenizer(TOK,cfg)\nv=tok.get_vocab_size()\nprint(\"vocab:\",v,\"| ids:\",tok.pad_id,tok.unk_id,tok.bos_id,tok.eos_id)\nassert v==8000 and (tok.pad_id,tok.unk_id,tok.bos_id,tok.eos_id)==(0,1,2,3)\nids=tok.encode(\"Tokenizer check for NexusAI Core-01.\",add_special_tokens=True)\nprint(\"encode len:\",len(ids),\"| decode ok:\",bool(tok.decode(ids)))\nTOKENIZER_OK=True"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 13 \u2014 Model Configuration Verification"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "MODEL_CFG_OK=False\nexpected={\"n_layers\":6,\"n_heads\":8,\"d_model\":256,\"d_ff\":1024,\n          \"max_len\":512,\"vocab_size\":8000}\nactual={k:getattr(cfg,k,None) for k in expected}\nprint(\"config:\",actual)\nassert actual==expected, f\"config mismatch: {actual}\"\nMODEL_CFG_OK=True\nprint(\"MODEL_CFG_OK =\",MODEL_CFG_OK)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 14 \u2014 Model Init, Forward Pass & Loss Check (CPU-safe)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "MODEL_OK=False\nmodel=NexusAICore01(cfg)\nn=model.count_parameters()\nprint(\"params:\",n,\"(expected 8,842,560)\")\nassert n==8_842_560\nmodel.eval()\nimport torch\nx=torch.randint(0,cfg.vocab_size,(1,cfg.max_len))\ny=torch.randint(0,cfg.vocab_size,(1,cfg.max_len))\nwith torch.no_grad():\n    out=model(x,targets=y)\nprint(\"forward ok | loss:\",float(out[\"loss\"]),\"| logits shape:\",tuple(out[\"logits\"].shape))\nassert out[\"logits\"].shape==(1,cfg.max_len,cfg.vocab_size)\nMODEL_OK=True"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 15 \u2014 GPU & VRAM Verification"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "GPU_OK=False\nif not torch.cuda.is_available():\n    print(\"CUDA unavailable \u2014 set Runtime > Change runtime type > T4 GPU, then re-run.\")\nelse:\n    p=torch.cuda.get_device_properties(0)\n    print(\"gpu:\",p.name,\"| vram %.2f GB\"%(p.total_memory/1e9),\n          \"| capability\",p.major,p.minor)\n    gm=NexusAICore01(cfg).cuda()\n    torch.cuda.reset_peak_memory_stats()\n    gm.train()\n    x=torch.randint(0,cfg.vocab_size,(2,cfg.max_len),device=\"cuda\")\n    y=torch.randint(0,cfg.vocab_size,(2,cfg.max_len),device=\"cuda\")\n    with torch.autocast(\"cuda\",dtype=torch.float16):\n        o=gm(x,targets=y)\n    o[\"loss\"].backward()\n    print(\"probe loss:\",float(o[\"loss\"]),\"| peak VRAM %.2f GB\"%\n          (torch.cuda.max_memory_allocated()/1e9))\n    del gm,x,y,o; torch.cuda.empty_cache()\n    print(\"fp16 path OK (T4=sm_75, bf16 unavailable -> fp16 used)\")\n    GPU_OK=True\nprint(\"GPU_OK =\",GPU_OK)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 16 \u2014 Training Configuration Review"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "DRIVER=\"/content/nexusai/packages/ai-core/core01/pretraining_driver.py\"\ntrain_path=os.path.join(PREPARED,\"english_train.jsonl\")\nval_path=os.path.join(PREPARED,\"english_val.jsonl\")\nCKPT_SMOKE=\"/content/drive/MyDrive/NexusAI/checkpoints_smoke\"\nCKPT_FULL=\"/content/drive/MyDrive/NexusAI/checkpoints_full\"\nTOK=\"/content/nexusai/packages/ai-core/data/experimental/phase9_2/tokenizers/bpe_8k/sp_bpe_8k.model\"\nSMOKE_CMD=[sys.executable,DRIVER,\n \"--train-file\",train_path,\"--val-file\",val_path,\n \"--output-dir\",CKPT_SMOKE,\"--tokenizer\",TOK,\n \"--device\",\"cuda\",\"--precision\",\"fp16\",\n \"--batch-size\",\"32\",\"--gradient-accumulation-steps\",\"1\",\n \"--learning-rate\",\"3e-4\",\"--warmup-steps\",\"100\",\n \"--epochs\",\"1\",\"--max-steps\",\"200\",\n \"--checkpoint-interval\",\"100\",\"--eval-interval\",\"100\",\n \"--log-interval\",\"10\"]\nprint(\"SMOKE plan (200 real steps, fp16, bs32, seq512, single T4):\")\nprint(\" \".join(SMOKE_CMD))\nprint()\nprint(\"est. VRAM ~2-4GB | est. time ~5-15min (measured in smoke)\")\nprint(\"Full run: same driver, no --max-steps, ckpt ->\",CKPT_FULL)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 17 \u2014 GPU Smoke Test \u2014 **OWNER APPROVAL GATE**\n\n`APPROVE_SMOKE_TEST=False` default. When True: ~200 real optimizer steps on\nthe actual corpus, fp16 AMP, checkpoints to Drive. Validates pipeline only \u2014\ndoes NOT mean the model is trained."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "APPROVE_SMOKE_TEST=False   # <-- owner sets True after reviewing Cell 16\nSMOKE_DONE=False\nif not APPROVE_SMOKE_TEST:\n    print(\"SMOKE BLOCKED: APPROVE_SMOKE_TEST=False (default).\")\nelse:\n    import subprocess\n    assert CLONE_OK and DATASET_OK and TOKENIZER_OK and MODEL_OK and GPU_OK, \\\n        \"preconditions failed\"\n    print(\"running smoke:\", \" \".join(SMOKE_CMD))\n    r=subprocess.run(SMOKE_CMD,cwd=\"/content/work\")\n    print(\"smoke exit:\",r.returncode)\n    SMOKE_DONE=(r.returncode==0)\n    print(\"SMOKE_DONE:\",SMOKE_DONE)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 18 \u2014 Smoke Test Evaluation (read-only)"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "smoke_files=sorted(glob.glob(os.path.join(CKPT_SMOKE,\"*.pt\"))) if SMOKE_DONE else []\nprint(\"smoke checkpoints:\",[os.path.basename(p) for p in smoke_files])\nfor p in smoke_files[:3]: print(\" \",os.path.basename(p),\"%.1f MB\"%(os.path.getsize(p)/1e6))\nif smoke_files:\n    ck=torch.load(smoke_files[-1],map_location=\"cpu\",weights_only=False)\n    print(\"status:\",ck.get(\"model_status\"),\"| step:\",ck.get(\"step\"),\n          \"| epoch:\",ck.get(\"epoch\"))\nprint(\"REVIEW: loss decreased? finite? val_loss sane? -> then approve Cell 19\")"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 19 \u2014 Full Pretraining \u2014 **OWNER APPROVAL GATE**\n\n`APPROVE_FULL_TRAINING=False` default. Requires SMOKE_DONE=True.\nReal run over ~98.5M train tokens on 1\u00d7 T4. Checkpoints every 500 steps to\nDrive; session may end (~12h) \u2014 resume next session with --resume."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "APPROVE_FULL_TRAINING=False   # <-- owner sets True ONLY after smoke review\nFULL_DONE=False\nif not APPROVE_FULL_TRAINING:\n    print(\"FULL BLOCKED: APPROVE_FULL_TRAINING=False (default).\")\n    print(\"needs SMOKE_DONE=True + owner sign-off\")\nelse:\n    import subprocess\n    assert SMOKE_DONE,\"run+verify smoke first\"\n    FULL_CMD=[sys.executable,DRIVER,\n     \"--train-file\",train_path,\"--val-file\",val_path,\n     \"--output-dir\",CKPT_FULL,\"--tokenizer\",TOK,\n     \"--device\",\"cuda\",\"--precision\",\"fp16\",\n     \"--batch-size\",\"32\",\"--gradient-accumulation-steps\",\"1\",\n     \"--learning-rate\",\"3e-4\",\"--warmup-steps\",\"500\",\n     \"--epochs\",\"1\",\"--checkpoint-interval\",\"500\",\n     \"--eval-interval\",\"500\",\"--log-interval\",\"50\"]\n    print(\"FULL cmd:\",\" \".join(FULL_CMD))\n    print(\"est. optimizer steps ~%d (98.5M/(32*512)) \u2014 estimate\"%(98500000//(32*512)))\n    r=subprocess.run(FULL_CMD,cwd=\"/content/work\")\n    FULL_DONE=(r.returncode==0)\n    print(\"FULL_DONE:\",FULL_DONE)"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 20 \u2014 Checkpoint Verification"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "ckpts=sorted(glob.glob(os.path.join(CKPT_FULL,\"checkpoint_*.pt\"))+glob.glob(os.path.join(CKPT_SMOKE,\"checkpoint_*.pt\")))\nprint(\"checkpoints:\",[os.path.basename(p) for p in ckpts])\nif ckpts:\n    latest=ckpts[-1]\n    print(\"latest:\",os.path.basename(latest),\"%.1f MB\"%(os.path.getsize(latest)/1e6))\n    ck=torch.load(latest,map_location=\"cpu\",weights_only=False)\n    print(\"status:\",ck.get(\"model_status\"),\"| step:\",ck.get(\"step\"),\n          \"| epoch:\",ck.get(\"epoch\"))\n    print(\"scaler:\",ck.get(\"grad_scaler_state_dict\") is not None,\n          \"| rng:\",ck.get(\"rng_state\") is not None,\n          \"| tokenizer:\",ck.get(\"tokenizer_path\"))"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 21 \u2014 Generation Test (honest quality)\n\nLoads latest checkpoint via InferenceEngine; English + romanized prompts.\n100M English-only tokens -> weak Bengali expected. Judge honestly."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "GEN_DONE=False\nfinal=os.path.join(CKPT_FULL,\"checkpoint_final.pt\")\nif not os.path.exists(final):\n    c=sorted(glob.glob(os.path.join(CKPT_FULL,\"checkpoint_*.pt\")))\n    final=c[-1] if c else None\nif not final or not os.path.exists(final):\n    print(\"no trained checkpoint \u2014 generation skipped (UNTRAINED)\")\nelse:\n    try:\n        ck=torch.load(final,map_location=\"cpu\",weights_only=False)\n        gm=NexusAICore01(cfg); gm.load_state_dict(ck[\"model_state_dict\"],strict=True)\n        infer=InferenceEngine(gm,tok,cfg,device=\"cuda\" if torch.cuda.is_available() else \"cpu\")\n        for prompt in [\"The capital of France is\",\"bangladesher shohor\",\"ami bhate pari\"]:\n            try:\n                out=infer.generate(prompt,max_new_tokens=40,do_sample=False)\n                print(\"PROMPT:\",prompt); print(\"OUT:\",out); print(\"-\"*40)\n            except Exception as e: print(\"prompt failed:\",repr(e))\n        GEN_DONE=True\n    except Exception as e: print(\"generation failed:\",repr(e))"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": "## Cell 22 \u2014 Drive Backup & Session Report"
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": "import time, json\n# ensure latest ckpts are on Drive (they already write there; verify)\nfor d,l in [(CKPT_SMOKE,\"smoke\"),(CKPT_FULL,\"full\")]:\n    fs=glob.glob(os.path.join(d,\"*.pt\"))\n    print(l,\"ckpts:\",len(fs),\"files, %.0f MB\"%(sum(os.path.getsize(p) for p in fs)/1e6))\nprint(\"=\"*58)\nprint(\"NEXUSAI CORE-01 COLAB SESSION REPORT\")\nfor n,v in [(\"CLONE_OK\",globals().get(\"CLONE_OK\")),(\"ENV_OK\",globals().get(\"ENV_OK\")),\n            (\"DRIVE_OK\",globals().get(\"DRIVE_OK\")),(\"STORAGE_OK\",globals().get(\"STORAGE_OK\")),\n            (\"FINEWEB_OK\",globals().get(\"FINEWEB_OK\")),(\"PREP_DONE\",globals().get(\"PREP_DONE\")),\n            (\"DATASET_OK\",globals().get(\"DATASET_OK\")),(\"TOKENIZER_OK\",globals().get(\"TOKENIZER_OK\")),\n            (\"MODEL_OK\",globals().get(\"MODEL_OK\")),(\"GPU_OK\",globals().get(\"GPU_OK\")),\n            (\"SMOKE_DONE\",globals().get(\"SMOKE_DONE\")),(\"FULL_DONE\",globals().get(\"FULL_DONE\")),\n            (\"GEN_DONE\",globals().get(\"GEN_DONE\"))]:\n    print(\"%-16s: %s\"%(n,v))\nprint(\"=\"*58)\nprint(\"Paste into README 'Training Session Log'.\")\nprint(\"CORE-01 STATUS:\",\"check checkpoint_final.pt\" if FULL_DONE else \"UNTRAINED\")"
  }
