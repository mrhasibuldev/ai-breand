# Names only; use a local secret manager or untracked .env file.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Database Configuration
# Provider: postgresql (Neon PostgreSQL)
# Connection string format: postgresql://[user].[project_id]:[password]@[neon-hostname]/[database]?sslmode=verify-full
# Get your connection string from Neon dashboard: https://neon.tech
DATABASE_PROVIDER=postgresql
DATABASE_URL=
DATABASE_POOL_SIZE=20

# Cookie Secret for HTTP-only session cookie signing
# Generate a random string: openssl rand -base64 32
COOKIE_SECRET=

# AI Service Configuration (Python ML service)
AI_SERVICE_URL=http://127.0.0.1:8000

# Identity & Authentication
IDENTITY_ISSUER_URL=
IDENTITY_AUDIENCE=

# AI Provider Configuration
AI_PROVIDER_ALIAS=mock
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# Object Storage Configuration
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
