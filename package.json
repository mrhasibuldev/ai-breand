{
  "name": "nexusai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @nexusai/web --filter @nexusai/api --filter @nexusai/worker dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.json eslint.config.mjs .prettierrc.json README.md vitest.config.ts apps packages tests",
    "test": "vitest run",
    "test:foundation": "pnpm --filter @nexusai/api... build && vitest run tests",
    "test:keyboard": "pnpm --filter @nexusai/api... build && playwright test",
    "guardrails": "node scripts/check-secrets.mjs && node scripts/check-architecture.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.24",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fastify": "5.12.5",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
